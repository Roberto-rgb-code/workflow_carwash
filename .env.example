# --- App ---
PORT=3000
PUBLIC_BASE_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app
N8N_API_KEY=change-me-long-random
WHATSAPP_START_URL=https://wa.me/52XXXXXXXXXX?text=Hola%20quiero%20lavado%20Car%20Wash%20Pro

# --- Database (Railway Postgres lo inyecta) ---
