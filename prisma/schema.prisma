generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  SERVICE_SELECTED
  IN_COVERAGE
  CAR_INFO
  LOCATION_SET
  AWAITING_PAYMENT
  PAID
  ASSIGNED
  FOUND
  WASHING
  DONE
  SURVEYED
  CANCELLED
}

enum SurveyScore {
  BAD
  OK
  GREAT
}

model Customer {
  id          String   @id @default(cuid())
  waPhone     String   @unique @map("wa_phone")
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  orders      Order[]

  @@map("customers")
}

model Service {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  priceCents  Int      @map("price_cents")
  currency    String   @default("mxn")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  orders      Order[]

  @@map("services")
}

model Washer {
  id        String   @id @default(cuid())
  name      String
  waPhone   String   @unique @map("wa_phone")
  lat       Float?
  lng       Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orders    Order[]

  @@map("washers")
}

model Order {
  id              String      @id @default(cuid())
  publicToken     String      @unique @default(cuid()) @map("public_token")
  status          OrderStatus @default(NEW)
  customerId      String      @map("customer_id")
  serviceId       String?     @map("service_id")
  washerId        String?     @map("washer_id")
  coverageOk      Boolean?    @map("coverage_ok")
  paymentAccepted Boolean?    @map("payment_accepted")
  plateLast3      String?     @map("plate_last3")
  carBrand        String?     @map("car_brand")
  carModel        String?     @map("car_model")
  carYear         Int?        @map("car_year")
  carColor        String?     @map("car_color")
  carConfirmed    Boolean?    @map("car_confirmed")
  lat             Float?
  lng             Float?
  locationAddress String?     @map("location_address")
  stripeSessionId String?     @map("stripe_session_id")
  stripePaymentId String?     @map("stripe_payment_id")
  paidAt          DateTime?   @map("paid_at")
  assignedAt      DateTime?   @map("assigned_at")
  foundAt         DateTime?   @map("found_at")
  washingAt       DateTime?   @map("washing_at")
  doneAt          DateTime?   @map("done_at")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  customer Customer     @relation(fields: [customerId], references: [id])
  service  Service?     @relation(fields: [serviceId], references: [id])
  washer   Washer?      @relation(fields: [washerId], references: [id])
  media    OrderMedia[]
  survey   Survey?
  events   OrderEvent[]

  @@index([status])
  @@index([customerId])
  @@map("orders")
}

model OrderMedia {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  kind      String
  url       String
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_media")
}

model Survey {
  id        String      @id @default(cuid())
  orderId   String      @unique @map("order_id")
  score     SurveyScore
  comment   String?
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("surveys")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  type      String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

model CoverageZone {
  id        String   @id @default(cuid())
  name      String
  polygon   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("coverage_zones")
}
