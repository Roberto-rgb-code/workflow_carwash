    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inbound = $('Build Prompt').item.json;\nlet raw = $json.message?.content || $json.text || $json.output || $json;\nif (typeof raw === 'object' && raw.content) raw = raw.content;\nif (Array.isArray(raw)) {\n  raw = raw.map(p => p.text || p.content || '').join('\\n');\n}\nlet parsed;\ntry {\n  const text = typeof raw === 'string' ? raw : JSON.stringify(raw);\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match ? match[0] : text);\n} catch (e) {\n  parsed = { reply: typeof raw === 'string' ? raw : 'Perdón, ¿me repites?', patch: null, actions: [] };\n}\nreturn {\n  json: {\n    API_BASE: inbound.API_BASE,\n    TWILIO_FROM: inbound.TWILIO_FROM,\n    TWILIO_ACCOUNT_SID: inbound.TWILIO_ACCOUNT_SID,\n    CURRENCY: inbound.CURRENCY,\n    waPhone: inbound.waPhone,\n    from: inbound.from,\n    orderId: inbound.order.id,\n    publicToken: inbound.order.publicToken,\n    locateUrl: inbound.order.locateUrl,\n    order: inbound.order,\n    mediaIn: inbound.media,\n    reply: parsed.reply || 'Listo, te sigo.',\n    patch: parsed.patch || null,\n    actions: parsed.actions || [],\n    survey: parsed.survey || null,\n    washerUpdate: parsed.washerUpdate || null,\n    car: {\n      brand: (parsed.patch && parsed.patch.carBrand) || inbound.order.carBrand,\n      model: (parsed.patch && parsed.patch.carModel) || inbound.order.carModel,\n      year: (parsed.patch && parsed.patch.carYear) || inbound.order.carYear,\n      color: (parsed.patch && parsed.patch.carColor) || inbound.order.carColor\n    }\n  }\n};"
      },
