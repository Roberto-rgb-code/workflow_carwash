    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || $json;\nconst from = String(body.From || body.from || '').trim();\nconst to = String(body.To || body.to || '').trim();\nconst text = String(body.Body || body.body || body.MessageSid && body.Body || '').trim();\nconst numMedia = Number(body.NumMedia || 0);\nconst media = [];\nfor (let i = 0; i < numMedia; i++) {\n  const url = body[`MediaUrl${i}`];\n  if (url) media.push(url);\n}\nconst waPhone = from.replace(/^whatsapp:/, '');\nreturn {\n  json: {\n    ...($json.API_BASE ? {} : {}),\n    API_BASE: $('Config WA').item.json.API_BASE,\n    TWILIO_FROM: $('Config WA').item.json.TWILIO_FROM,\n    TWILIO_ACCOUNT_SID: $('Config WA').item.json.TWILIO_ACCOUNT_SID,\n    CURRENCY: $('Config WA').item.json.CURRENCY,\n    from,\n    to,\n    waPhone,\n    text,\n    media,\n    isWasherHint: /^\\s*(ENCONTRADO|TERMINADO|FOTOS)/i.test(text)\n  }\n};"
      },
